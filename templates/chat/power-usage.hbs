<div class="chat-card power-usage">
  <h4 title="{{ power.system.description }}">{{ power.name }}</h4>

  {{! Show resource costs if resources were spent }}
  {{#if consumptions}}
    <div class="resource-cost">
      {{#if strainCost}}
        <span class="strain-cost">
          <i class="fas fa-bolt"></i>
          {{strainCost}} System Strain
        </span>
      {{/if}}
      {{#each consumptions}}
        {{#unless (eq type "systemStrain")}}
          <span class="consumption-cost consumption-{{type}}">
            <i class="fas fa-circle-minus"></i>
            {{#if (eq type "uses")}}
              {{spent}} {{localize "swnr.consumption.uses"}} {{#if cadence}}
                {{#if (eq cadence "day")}}{{localize 'swnr.effort.dayShort'}}
                {{else if (eq cadence "scene")}}{{localize 'swnr.effort.sceneShort'}}
                {{else}}{{localize 'swnr.effort.commitShort'}}
                {{/if}}
              {{/if}}
            {{else if (eq type "consumableItem")}}
              {{spent}} {{localize "swnr.consumption.consumed"}}
              {{#if items}}
                :
                {{#each items}}
                  {{itemName}} × {{amount}}{{#unless @last}}, {{/unless}}
                {{/each}}
              {{/if}}
            {{else}}
              {{spent}} {{resourceName}}{{#if subResource}}:{{subResource}}{{/if}} {{#if cadence}}
                {{#if (eq cadence "day")}}{{localize 'swnr.effort.dayShort'}}
                {{else if (eq cadence "scene")}}{{localize 'swnr.effort.sceneShort'}}
                {{else}}{{localize 'swnr.effort.commitShort'}}
                {{/if}}
              {{/if}}
            {{/if}}
          </span>
        {{/unless}}
      {{/each}}
    </div>
  {{/if}}

  <div class="chat-desc">
    {{#if (wouldTrim power.system.description 200)}}
      <span class="hiddenShort">
        {{{trim power.system.description 200}}}
        <div class="border border-gray-700 placeholder-blue-800 pt-0">
          <button class="longShowDesc">{{localize "swnr.sheet.showLongDesc"}}</button>
        </div>
      </span>
      <div class="border border-gray-700 placeholder-blue-800 pt-0">
        <span style="display:none" class="hiddenLong">
        {{{ power.system.description }}}
        <button class="longHideDesc">{{localize "swnr.sheet.hideLongDesc"}}</button>
        </span>
      </div>
    {{else}}
      <span>
        {{{power.system.description }}}
      </span>
    {{/if}}
  </div>

  {{#if power.system.range}}
      <div>
        {{localize 'swnr.sheet.powers.range'}}: {{ power.system.range }}
      </div>
  {{/if}}

  {{#if power.system.duration}}
      <div>
        {{localize 'swnr.sheet.powers.duration'}}: {{ power.system.duration }}
      </div>
  {{/if}}

  {{#if power.system.level}}
      <div>
        {{localize 'swnr.sheet.powers.level'}}: {{ power.system.level }}
      </div>
  {{/if}}

  {{#if power.system.roll}}
    <div class="power-roll">
      <span>{{localize 'swnr.sheet.powers.roll'}}:</span>
      <span class="roll roll-damage">{{{ powerRoll }}}</span>
    </div>
  {{/if}}

  {{#if targetResults}}
    <div class="power-targets">
      <table class="power-targets-table">
        <thead>
          <tr>
            <th>{{localize "swnr.power.table.target"}}</th>
            <th>{{localize "swnr.power.table.save"}}</th>
            <th>{{localize "swnr.power.table.effect"}}</th>
            <th class="target-actions-col"></th>
          </tr>
        </thead>
        <tbody>
          {{#each targetResults}}
            <tr data-target-index="{{@index}}">
              <td class="target-name">{{name}}</td>
              <td class="target-save">
                {{#if save}}
                  {{#if save.success}}<i class="fas fa-shield-halved" title="saved"></i>{{else}}<i class="fas fa-burst" title="failed"></i>{{/if}}
                  {{save.total}}{{#if save.target}}/{{save.target}}{{/if}}
                {{else}}—{{/if}}
              </td>
              <td class="target-effect">
                <span class="effect-amount">{{amountLabel}}</span>
                {{#if (eq status "applied")}}
                  <i class="fas fa-check target-applied-icon" title="{{localize 'swnr.power.status.applied'}}"></i>
                {{else if (eq status "awaitingGM")}}
                  <i class="fas fa-hourglass-half target-awaiting-icon" title="{{localize 'swnr.power.status.awaitingGM'}}"></i>
                {{else if (eq status "reverted")}}
                  <i class="fas fa-rotate-left target-reverted-icon" title="{{localize 'swnr.power.status.reverted'}}"></i>
                {{/if}}
              </td>
              <td class="target-actions">
                {{#if (eq status "applied")}}
                  <span class="gm-only target-gm-controls">
                    <button type="button" class="target-reroll" data-action="reroll-target" data-target-index="{{@index}}" title="{{localize 'swnr.power.reroll'}}">
                      <i class="fas fa-dice"></i>
                    </button>
                    <button type="button" class="target-undo" data-action="revert-target" data-target-index="{{@index}}" title="{{localize 'swnr.power.undo'}}">
                      <i class="fas fa-rotate-left"></i>
                    </button>
                  </span>
                {{else if (or (eq status "manual") (eq status "pending"))}}
                  <button type="button" data-action="apply-target" data-target-index="{{@index}}">
                    {{localize "swnr.power.apply"}}
                  </button>
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      <div class="power-targets-footer gm-only">
        <button type="button" data-action="revert-all">
          <i class="fas fa-rotate-left"></i> {{localize "swnr.power.undoAll"}}
        </button>
      </div>
    </div>
  {{/if}}

  {{! Manual save button is redundant once saves auto-roll per target }}
  {{#unless targetResults}}
  {{#if power.system.save}}
  <div class="card-buttons">
      <button data-action="save" data-save="{{power.system.save}}">
          {{localize "swnr.sheet.powers.save"}} {{power.system.save}}
      </button>
  </div>
  {{/if}}
  {{/unless}}

  {{#if power.system.skill}}
  <div class="card-buttons">
      <button data-action="skill" data-skill="{{power.system.skill}}">
          {{power.system.skill}}
      </button>
  </div>
  {{/if}}

  {{#if isPassive}}
    <div class="passive-indicator">
      <i class="fas fa-info-circle"></i>
      <span>{{localize "swnr.sheet.passive"}}</span>
    </div>
  {{else}}
    <div class="card-buttons resource-management">
      {{#if consumableRequirements.length}}
        <div class="consume-requirements-line">
          <i class="fas fa-cubes"></i>
          {{#if (eq consumableRequirements.length 1)}}
            {{localize "swnr.consumption.selectDialog.requirements.single"}}
          {{else}}
            {{localize "swnr.consumption.selectDialog.requirements.multiple"}}
          {{/if}}
          {{#each consumableRequirements}}
            ({{amount}}) {{text}}{{#unless @last}}, {{/unless}}
          {{/each}}
        </div>
      {{/if}}
      {{! Show recovery buttons for already processed consumptions }}
      {{#if strainCost}}
        <button data-action="recover-strain" data-amount="{{strainCost}}" data-actor-id="{{actor.id}}">
          <i class="fas fa-heart"></i>
          {{localize "swnr.consumption.recoverStrain"}} {{strainCost}}
        </button>
      {{/if}}

      {{! Show consumption buttons for unprocessed manual consumptions only (timing: "manual") }}
      {{#each power.system.consumptions}}
        {{#if (and (ne type "none") (eq timing "manual"))}}
          {{#unless (eq type "consumableItem")}}
            {{! Check if this consumption has already been processed }}
            {{#unless (lookup ../processedConsumptions @index)}}
              <button data-action="use-consumption" data-power-id="{{../power.id}}" data-actor-id="{{../actor.id}}" data-consumption-index="{{@index}}">
                {{#if (eq type "poolResource")}}
                  <i class="fas fa-battery-half"></i>
                  Spend {{usesCost}} {{resourceName}}{{#if subResource}}:{{subResource}}{{/if}} {{#if cadence}}
                    {{#if (eq cadence "day")}}{{localize 'swnr.effort.dayShort'}}
                    {{else if (eq cadence "scene")}}{{localize 'swnr.effort.sceneShort'}}
                    {{else}}{{localize 'swnr.effort.commitShort'}}
                    {{/if}}
                  {{/if}}
                {{else if (eq type "systemStrain")}}
                  <i class="fas fa-heart-broken"></i>
                  Take {{usesCost}} {{localize "swnr.consumption.systemStrain"}}
                {{else if (eq type "uses")}}
                  <i class="fas fa-minus-circle"></i>
                  Use {{usesCost}} {{localize "swnr.consumption.uses"}} {{#if cadence}}
                    {{#if (eq cadence "day")}}{{localize 'swnr.effort.dayShort'}}
                    {{else if (eq cadence "scene")}}{{localize 'swnr.effort.sceneShort'}}
                    {{else}}{{localize 'swnr.effort.commitShort'}}
                    {{/if}}
                  {{/if}}
                {{/if}}
              </button>
            {{/unless}}
          {{/unless}}
        {{/if}}
      {{/each}}

      {{! Single combined button for all manual consumable-item costs }}
      {{#if hasUnprocessedConsumableManual}}
        <button data-action="use-consumables" data-power-id="{{power.id}}" data-actor-id="{{actor.id}}">
          <i class="fas fa-cubes"></i>
          {{localize "swnr.consumption.action.consume"}} {{localize "swnr.consumption.consumableItem"}}
        </button>
      {{/if}}
    </div>
  {{/if}}
</div>
