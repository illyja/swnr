{{! Attributes Tab }}
<section class='tab attributes {{tab.cssClass}}' data-group='primary' data-tab='attributes'>
  
   {{! Ammo Section }}
  <div class='consumable-section resource-group grid grid-3col' style="border: 1px solid var(--border-color); border-radius: 2px; padding: 4px;">
    <div class="grid-span-2">
      {{formGroup systemFields.uses.fields.consumable value=system.uses.consumable localize=true}}
    </div>  
    {{#if (ne system.uses.consumable "none")}}
      <div class="grid-span-2">
        {{formGroup systemFields.uses.fields.ammo value=system.uses.ammo localize=true}}
      </div>
      <div class='resource flexrow'>
        <label class='resource-label'>{{localize 'SWN.Item.Gear.FIELDS.uses.label'}}</label>
        {{formInput systemFields.uses.fields.value value=system.uses.value localize=true}} /
        {{formInput systemFields.uses.fields.max value=system.uses.max localize=true}}
      </div>
      {{!-- Magazines are always kept when empty, so the empties fields don't apply. --}}
      {{#unless (eq system.uses.consumable "magazine")}}
      <div class="grid-span-2">
        {{formGroup systemFields.uses.fields.emptyQuantity value=system.uses.emptyQuantity localize=true}}
      </div>
      {{formGroup systemFields.uses.fields.keepEmpty value=system.uses.keepEmpty localize=true widget=checkWidget}}
      {{/unless}}
      {{#if (eq system.uses.consumable "magazine")}}
      <div class="grid-span-2">
        <label class='resource-label'>{{localize 'swnr.weapon.magClass'}}</label>
        <input type="text" name="system.uses.magClass" value="{{system.uses.magClass}}"
          placeholder="{{localize 'swnr.weapon.magClassHint'}}" />
      </div>
      {{/if}}
      {{#if (ne system.uses.ammo "none")}}
      <div class="grid-span-2">
        <label class='resource-label'>{{localize 'swnr.weapon.caliber'}}</label>
        <input type="text" name="system.uses.caliber" value="{{system.uses.caliber}}" list="{{item.uuid}}-calibers" autocomplete="off"
          placeholder="{{localize 'swnr.weapon.caliberHint'}}" />
        <datalist id="{{item.uuid}}-calibers">{{#each calibers}}<option value="{{this}}"></option>{{/each}}</datalist>
      </div>
      {{/if}}
    {{/if}}
  </div>

  {{! Ammo profile: how these rounds (or the rounds loaded in this magazine) change the weapon }}
  {{#if (and (ne system.uses.consumable "none") (ne system.uses.ammo "none"))}}
  {{#with systemFields.ammoProfile.fields as |pf|}}
  <fieldset class="ammo-profile">
    <legend>{{localize 'swnr.ammoProfile.legend'}}</legend>
    <p class="help-text">{{#if (eq ../system.uses.consumable "magazine")}}{{localize 'swnr.ammoProfile.loadedHint'}}{{else}}{{localize 'swnr.ammoProfile.hint'}}{{/if}}</p>
    <div class="grid grid-4col">
      <div class="grid-span-2">
        <label class="resource-label">{{localize 'swnr.ammoProfile.label'}}</label>
        {{formInput pf.label value=../system.ammoProfile.label placeholder=(localize 'swnr.ammoProfile.labelHint')}}
      </div>
      <div>
        <label class="resource-label">{{localize 'swnr.ammoProfile.damage'}}</label>
        {{formInput pf.damage value=../system.ammoProfile.damage}}
      </div>
      <div>
        <label class="resource-label">{{localize 'swnr.ammoProfile.hitMod'}}</label>
        {{formInput pf.hitMod value=../system.ammoProfile.hitMod}}
      </div>
      <div class="grid-span-2">
        <label class="resource-label">{{localize 'swnr.ammoProfile.range'}}</label>
        <div class="flexrow" style="gap: 2px;">
          {{formInput pf.rangeNormal value=../system.ammoProfile.rangeNormal}} /
          {{formInput pf.rangeMax value=../system.ammoProfile.rangeMax}}
        </div>
      </div>
      <div>
        <label class="resource-label">{{localize 'swnr.ammoProfile.traumaDie'}}</label>
        {{formInput pf.traumaDie value=../system.ammoProfile.traumaDie}}
      </div>
      <div>
        <label class="resource-label">{{localize 'swnr.ammoProfile.traumaRating'}}</label>
        {{formInput pf.traumaRating value=../system.ammoProfile.traumaRating}}
      </div>
      <div class="grid-span-2" title="{{localize 'swnr.ammoProfile.nonLethalHint'}}">
        <label class="resource-label">{{localize 'swnr.ammoProfile.nonLethal'}}</label>
        {{formInput pf.nonLethal value=../system.ammoProfile.nonLethal}}
      </div>
      <div class="grid-span-2">
        <label class="resource-label">{{localize 'swnr.ammoProfile.stoppedByAdvancedArmor'}}</label>
        {{formInput pf.stoppedByAdvancedArmor value=../system.ammoProfile.stoppedByAdvancedArmor}}
      </div>
    </div>
  </fieldset>
  {{/with}}
  {{/if}}

  {{! Roll Formula Section }}
  <div class='resource'>
    <label class='resource-label'>{{localize 'SWN.Item.Gear.FIELDS.rollFormula.label'}}:</label>
    <span>{{system.formula}}</span>
    <div class='grid grid-4col'>
      <div class='grid-span-1'>
        <label class='resource-label'>{{localize 'SWN.Item.Gear.FIELDS.numDice.label'}}</label>
        <input
          type='text'
          name='system.roll.diceNum'
          value='{{system.roll.diceNum}}'
          data-dtype='Number'
        />
      </div>
      <div class='grid-span-1'>
        <label class='resource-label'>{{localize 'SWN.Item.Gear.FIELDS.dieSize.label'}}</label>
        <input
          type='text'
          name='system.roll.diceSize'
          value='{{system.roll.diceSize}}'
          data-dtype='String'
        />
      </div>
      <div class='grid-span-2'>
        <label class='resource-label'>{{localize 'SWN.Item.Gear.FIELDS.rollMod.label'}}</label>
        <input
          type='text'
          name='system.roll.diceBonus'
          value='{{system.roll.diceBonus}}'
          data-dtype='String'
        />
      </div>
    </div>

  </div>

  {{! Container Settings Section }}
  <div class='resource-group grid grid-4col' style="border: 1px solid var(--border-color); border-radius: 2px; padding: 4px; margin-top: 8px;">
    <div class="grid-span-4">
      <label class='resource-label'>{{localize 'swnr.item.container.settings'}}</label>
    </div>
    <div class="grid-span-4">
      {{formGroup systemFields.container.fields.isContainer value=system.container.isContainer localize=true widget=checkWidget}}
    </div>
    {{#if system.container.isContainer}}
      <div class="resource">
        {{formGroup systemFields.container.fields.capacity.fields.max value=system.container.capacity.max localize=true}}
      </div>
      <div class="grid-span-2">
        {{formGroup systemFields.container.fields.isOpen value=system.container.isOpen localize=true widget=checkWidget}}
      </div>
    {{/if}}
  </div>

</section>