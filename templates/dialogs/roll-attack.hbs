<form class="swnr-roll-dialog">
  <input type="hidden" name="actorId" value="{{actor._id}}">

  {{#if (eq actor.type 'character')}}
  <div class="form-group">
    <label for="skill">{{localize 'swnr.sheet.skill'}}</label>
    <select name="skill" id="skill" required>
      {{selectOptions (getSkillChoices skills true) selected=skill localize=true}}
    </select>
  </div>
  {{/if}}

  {{#if (eq 'ask' statName)}}
  <div class="form-group">
    <label for="stat">{{localize 'swnr.sheet.stats'}}</label>
    <select name="stat" id="stat">
      {{#each stats as |box name|}}
      <option value="{{name}}" {{#if (eq name @root.selectedStat)}}selected{{/if}}>
        {{localize (concat "swnr.stat.long." name)}}: {{numberFormat box.mod decimals=0 sign=true}}
      </option>
      {{/each}}
    </select>
  </div>
  {{else}}
  <input type="hidden" name="statName" value="{{statName}}">
  {{/if}}

  <div class="form-group">
    <label for="modifier">{{localize 'swnr.chat.modifier'}}</label>
    <input name="modifier" id="modifier" type="number" step="1" value="{{modifier}}">
  </div>

  {{#if (and weapon.ammo.burst (ne 'none' weapon.ammo.type))}}
  <div class="form-group">
    <label for="burstFire">{{localize 'swnr.weapon.burst'}}</label>
    <input type="checkbox" name="burstFire" id="burstFire" {{checked burstChecked}}>
  </div>
  {{/if}}

  {{#if canSuppress}}
  <div class="form-group">
    <label for="suppress">{{localize 'swnr.weapon.suppress.checkbox'}}</label>
    <input type="checkbox" name="suppress" id="suppress">
  </div>
  {{/if}}

  {{#if allowRemember}}
  <div class="form-group">
    <label for="remember">{{localize 'swnr.weapon.remember'}}</label>
    <input type="checkbox" name="remember" id="remember" {{checked rememberChecked}}>
  </div>
  {{/if}}
</form>
